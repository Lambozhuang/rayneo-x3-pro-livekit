# Copy to backend/.env and fill in. backend/.env is gitignored.

# livekit-server (setup.sh writes the key pair here and into livekit.yaml)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://192.168.1.10:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# api
AUTH_MODE=dev
API_PORT=3000

# agent: openai (GPT-Live + brain), gemini or realtime (OpenAI Realtime)
AGENT_NAME=rayneo
AGENT_BACKEND=openai

# openai: GPT-Live voice
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1

# openai: the brain
BRAIN_PROVIDER=anthropic
BRAIN_MODEL=claude-sonnet-5-5
BRAIN_EFFORT=low
ANTHROPIC_API_KEY=

# gemini: one model that hears, sees and speaks
GOOGLE_API_KEY=
# gemini-3.8-live, or gemini-3.8-live-extended-thinking with a THINKING_LEVEL (low | medium | high)
GEMINI_MODEL=gemini-3.8-live
#GEMINI_THINKING_LEVEL=
# camera frames a second shown to the model (every one stays in its context; 1 is the Live API's most), each the
# middle square of the frame scaled to SIDE x SIDE px (Google recommends 768)
GEMINI_VIDEO_FPS=1
GEMINI_SIDE=768
# tokens the model spends on a frame: MEDIA_RESOLUTION_LOW | MEDIUM | HIGH (70, 70, 280; unset = the API
# default, 70). HIGH is the most the Live API gives a frame.
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_LOW

# realtime: one OpenAI model that hears, sees and speaks the LEGO build (uses OPENAI_API_KEY above)
REALTIME_MODEL=gpt-realtime-2.1
# how hard the model reasons before it answers: minimal | low | medium | high | xhigh (required)
REALTIME_REASONING_EFFORT=medium
# camera frames a second shown to the model while the wearer speaks and while they do not (every one stays in its
# context), each the bottom square of the frame scaled to SIDE px
REALTIME_SPEAKING_FPS=1
REALTIME_SILENT_FPS=0.3
REALTIME_SIDE=1080
