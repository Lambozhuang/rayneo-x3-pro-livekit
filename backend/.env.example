# Copy to backend/.env and fill in. .env holds the real values and is gitignored.
# One file for both services; each reads what it needs.

# ---- livekit-server -------------------------------------------------------
# Where the api and the agent reach livekit-server. Everything in compose uses
# host networking, so this is loopback, the same as running with `uv run`.
LIVEKIT_URL=ws://127.0.0.1:7880
# What the glasses are told to connect to: this machine's LAN IP. Never loopback.
LIVEKIT_PUBLIC_URL=ws://192.168.1.10:7880
# Must match the `keys:` in the livekit-server yaml. `devkey`/`secret` are the
# `--dev` defaults, fine on a private LAN. Generate a real pair otherwise:
# `livekit-server generate-keys`.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- api: who may start a session ------------------------------------------
# dev     accept everyone. LAN debugging with the headset. Logs a warning.
# static  require `Authorization: Bearer $AUTH_STATIC_TOKEN`. Shared test box.
# jwt     require a JWT from an account system, verified with AUTH_JWT_KEY;
#         user id = its `sub`. What a product runs. See api/src/auth.py.
AUTH_MODE=dev
# AUTH_STATIC_TOKEN=
# AUTH_JWT_KEY=
# AUTH_JWT_ALGORITHM=HS256
# Host port the token endpoint is published on (the glasses' token_endpoint).
API_PORT=3000

# ---- agent -------------------------------------------------------------------
# Explicit dispatch: the api puts this name in every token, and the agent only
# joins rooms that ask for it by name.
AGENT_NAME=rayneo
# Which implementation runs: gemini (Gemini Live, agent/src/gemini) or openai
# (GPT-Live + a delegated backend model + a separate vision check, agent/src/gpt).
AGENT_BACKEND=gemini
# Build guide the agent walks the wearer through; see agent/guides. Relative to backend/agent.
BUILD_GUIDE=guides/two-bricks.toml
# The language the agent speaks, whatever it hears.
# AGENT_LANGUAGE=English
# Debugging: save the camera frames the model was shown (gemini) or that were
# checked (openai). In compose the path is /app/frames = backend/frames on the host.
# FRAME_DUMP_DIR=/app/frames
# FRAME_DUMP_MAX=60

# ---- agent, AGENT_BACKEND=openai -------------------------------------------
# OpenAI API key -- https://platform.openai.com/api-keys (needs GPT-Live access)
OPENAI_API_KEY=
# Voice model (priced per second), the backend model it delegates reasoning and
# tool calls to, and the vision model that judges camera frames in its own call.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_BACKEND_MODEL=gpt-6-luna
OPENAI_CHECK_MODEL=gpt-6-luna
# Reasoning effort of the backend / vision model: none, low, medium, high.
# OPENAI_BACKEND_EFFORT=low
# OPENAI_CHECK_EFFORT=none
# Image detail sent to the vision model: high (default) or original.
# OPENAI_CHECK_DETAIL=high
# OPENAI_VOICE=marin

# ---- agent, AGENT_BACKEND=gemini -------------------------------------------
# Google Gemini API key -- get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Live API model. Kept in env rather than in source so we can A/B other models.
GEMINI_MODEL=gemini-3.8-live
# Gemini Live voice. https://ai.google.dev/gemini-api/docs/live#change-voices
GEMINI_VOICE=Puck
# Tokens per camera frame: unset/MEDIA_RESOLUTION_MEDIUM = 70, MEDIA_RESOLUTION_HIGH = 280.
# GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
# Camera frames per second sent to the model while the wearer speaks / is silent;
# the model can always ask for one more with its `look` tool. See agent/src/sampler.py.
# VIDEO_SPEAKING_FPS=0.5
# VIDEO_SILENT_FPS=0
# Sliding window over the model's context, so long calls do not slow down turn by turn.
# `off` disables. See agent/src/config.py.
# GEMINI_CONTEXT_TRIGGER_TOKENS=24000
# GEMINI_CONTEXT_TARGET_TOKENS=12000
# Tool calls: non_blocking (default; the model talks over a running tool) or blocking.
# GEMINI_TOOL_BEHAVIOR=non_blocking
# Non-live Gemini 3 model for agent/src/inspect_frame.py (offline what-can-it-see checks).
# GEMINI_INSPECT_MODEL=gemini-3.8-flash
# Only for Linux hosts whose CPU lacks AVX2 (pre-2013 Intel): the default
# forkserver preloads a native model library that SIGILLs there. See agent.py.
# AGENT_MP_CONTEXT=spawn
