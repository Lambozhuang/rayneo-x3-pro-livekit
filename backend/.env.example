# Copy to backend/.env and fill in. .env holds the real values and is gitignored.
# One file for both services; each reads what it needs.

# ---- livekit-server -------------------------------------------------------
# Where the api and the agent reach livekit-server. It runs on the host, so
# from inside compose that is host.docker.internal; running the services
# directly with `uv run`, use ws://127.0.0.1:7880 instead.
LIVEKIT_URL=ws://host.docker.internal:7880
# What the glasses are told to connect to: this machine's LAN IP, or the
# public wss:// name when deployed behind Caddy. Never loopback.
LIVEKIT_PUBLIC_URL=ws://192.168.1.10:7880
# Must match the `keys:` in the livekit-server yaml. `devkey`/`secret` are the
# `--dev` defaults, fine on a private LAN. Generate a real pair otherwise:
# `livekit-server generate-keys`.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- api: who may start a session ------------------------------------------
# dev     accept everyone. LAN debugging with the headset. Logs a warning.
# static  require `Authorization: Bearer $AUTH_STATIC_TOKEN`. Shared test box.
# jwt     require a JWT from an account system, verified with AUTH_JWT_KEY;
#         user id = its `sub`. What a product runs. See api/src/auth.py.
AUTH_MODE=dev
# AUTH_STATIC_TOKEN=
# AUTH_JWT_KEY=
# AUTH_JWT_ALGORITHM=HS256
# Host port the token endpoint is published on (the glasses' token_endpoint).
API_PORT=3000

# ---- agent -------------------------------------------------------------------
# Explicit dispatch: the api puts this name in every token, and the agent only
# joins rooms that ask for it by name.
AGENT_NAME=rayneo
# Google Gemini API key -- get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Live API model. Kept in env rather than in source so we can A/B other models.
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Gemini Live voice. https://ai.google.dev/gemini-api/docs/live#change-voices
GEMINI_VOICE=Puck
# Only for Linux hosts whose CPU lacks AVX2 (pre-2013 Intel): the default
# forkserver preloads a native model library that SIGILLs there. See agent.py.
# AGENT_MP_CONTEXT=spawn
