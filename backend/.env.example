# Copy to backend/.env and fill in. backend/.env is gitignored.

# livekit-server (setup.sh writes the key pair here and into livekit.yaml)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://192.168.1.10:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# api
AUTH_MODE=dev
API_PORT=3000

# agent: openai (GPT-Live + brain) or gemini
AGENT_NAME=rayneo
AGENT_BACKEND=openai

# openai: GPT-Live voice
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1

# openai: the brain
BRAIN_PROVIDER=anthropic
BRAIN_MODEL=claude-sonnet-5-5
BRAIN_EFFORT=low
ANTHROPIC_API_KEY=

# gemini: one model that hears, sees and speaks
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck
# camera frames a second shown to the model (every one stays in its context), each the bottom square of the
# frame scaled to SIDE px
GEMINI_VIDEO_FPS=1
GEMINI_SIDE=1080
# optional: MEDIA_RESOLUTION_LOW | MEDIUM | HIGH (tokens per frame: 70, 70, 280; unset = the API default, 70),
# and the context window: drop the oldest turns past TRIGGER tokens down to TARGET (off = no compression,
# and Google then ends an audio-and-video session at two minutes)
#GEMINI_MEDIA_RESOLUTION=
#GEMINI_CONTEXT_TRIGGER_TOKENS=100000
#GEMINI_CONTEXT_TARGET_TOKENS=50000
