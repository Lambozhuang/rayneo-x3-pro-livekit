# Copy to .env.local and fill in. .env.local holds the real values and is gitignored.

# Self-hosted livekit-server running locally. These are the `--dev` defaults,
# which are well-known and not secrets. The agent sits on the same machine as the
# server, so this stays on loopback.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# What token_server.py advertises to the glasses. Set it to this machine's LAN IP:
# the glasses have to reach the SFU over IP, and forwarding the ports over USB is
# not a substitute -- `adb reverse` carries signaling but cannot carry media. See
# the README.
# LIVEKIT_PUBLIC_URL=ws://10.0.0.5:7880

# Google Gemini API key -- get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Live API model. Kept in env rather than in source so we can A/B other models.
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Gemini Live voice. https://ai.google.dev/gemini-api/docs/live#change-voices
GEMINI_VOICE=Puck
