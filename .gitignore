.env.local
.env
.venv/
__pycache__/
*.py[cod]
console-recordings/

# a deployed livekit-server config with real keys, kept next to the repo
/livekit.yaml
# per-host compose tweaks (network mode, ports)
backend/docker-compose.override.yml
# one record per call (RUN_DIR), and the copies pulled from the lab (deploy/pull_run.py)
backend/runs/
/logs/

# papers and standards, downloaded, not ours to redistribute
docs/*.pdf
docs/papers/

# scratch: PoC scripts and their output, not part of the project
tmp/

# what a small study generates from logs/; its code, labels and written result stay in git (eval/README.md)
eval/*/out/

# packet captures taken on the lab's netem bridge and the scripts that read them, kept on this machine only
traffic/
